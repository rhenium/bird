[Unit]
Description=BIRD Internet Routing Daemon
Documentation=man:bird(8)
Documentation=file:/usr/share/doc/bird2/bird.html
ConditionPathExists=/etc/bird/bird.conf
After=network.target

[Service]
Environment="BIRD_RUN_USER=bird BIRD_RUN_GROUP=bird"
EnvironmentFile=-/etc/bird/envvars
ExecStartPre=/usr/sbin/bird -p
ExecReload=/usr/sbin/birdc configure
ExecStart=/usr/sbin/bird -f -u $BIRD_RUN_USER -g $BIRD_RUN_GROUP $BIRD_ARGS
Restart=on-abnormal
ConfigurationDirectory=bird
RuntimeDirectory=bird

[Install]
WantedBy=multi-user.target
